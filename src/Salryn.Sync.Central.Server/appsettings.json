{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "CentralSync": {
    "DatabasePath": "data/salryn-cafe-central.db",
    "RequireHttps": true,
    "TrustForwardedProto": true,
    "JoinCodeTtlMinutes": 10,
    "ChallengeTtlSeconds": 120,
    "DeviceTokenTtlMinutes": 30,
    "OfflineLeaseHours": 24,
    "AdminSessionTtlMinutes": 480,
    "MaxAdminFailedAttempts": 5,
    "AdminLockoutMinutes": 5
  }
}
