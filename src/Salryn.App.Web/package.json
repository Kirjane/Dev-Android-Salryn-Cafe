{
  "name": "salryn-app-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/write-build-stamp.mjs",
    "preview": "vite preview",
    "test:po-print": "node --experimental-strip-types --test tests/purchase-order-print.test.mjs",
    "test:e2e": "playwright test --project=mocked-ui",
    "test:visual": "playwright test --project=mocked-ui --grep @visual",
    "test:visual:update": "playwright test --project=mocked-ui --grep @visual --update-snapshots=all",
    "test:integrated-host": "playwright test --project=integrated-host"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.66.9",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.2",
    "vite": "^6.2.0"
  }
}
