<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>Salryn.Desktop.WebView</RootNamespace>
    <AssemblyName>Salryn.Desktop.WebView</AssemblyName>
    <!-- WEB-A4 / PRELAN-HARDEN-4: WebView2 pulls a WPF companion assembly referencing WindowsBase 5.0 while the SDK provides 4.0. Runtime unification is safe for this standalone WinForms host; see PRELAN_HARDENING_CLOSURE.md. -->
    <NoWarn>$(NoWarn);MSB3277</NoWarn>
  </PropertyGroup>

  <!--
    WEB-A4 native dev host.
    Intentionally references no Salryn business projects (no WinForms app, no Core,
    no Infrastructure). It only hosts the web frontend in WebView2 and talks to the
    local API over HTTP.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4022.49" />
  </ItemGroup>

</Project>
